    "fetch",
    "claude",
    "cursor",
    "cline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matthewyin/deepseek-mcp.git"
  },
  "homepage": "https://github.com/Matthewyin/deepseek-mcp#readme",
